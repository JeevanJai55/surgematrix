# Public canonical site URL: use the exact HTTPS origin for production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# EmailJS account configuration. Keep the private key server-only.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Set only if your hosting proxy overwrites this header on every request.
CONTACT_TRUSTED_IP_HEADER=
